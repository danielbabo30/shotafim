# ─────────────────────────────────────────────────────────────
# העתק קובץ זה ל-.env ומלא ערכים אמיתיים. אל תעלה את .env ל-git.
# cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- בסיס נתונים (Neon / Supabase) ---
# DATABASE_URL = חיבור דרך pooler (pgBouncer) — לשימוש האפליקציה בזמן ריצה
# DIRECT_URL   = חיבור ישיר — לשימוש Prisma Migrate בלבד
DATABASE_URL="postgresql://user:password@HOST-pooler.REGION.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@HOST.REGION.aws.neon.tech/dbname?sslmode=require"

# --- Auth.js (NextAuth) ---
# צור מפתח: openssl rand -base64 33
AUTH_SECRET=""
# בפרודקשן: כתובת האתר המלאה, למשל https://example.com
AUTH_URL="http://localhost:3000"
# מגדיר trust ל-host מאחורי proxy (Vercel). השאר "true".
AUTH_TRUST_HOST="true"

# --- כניסה עם Google (אופציונלי בשלב זה) ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- כניסה עם קישור קסם במייל (אופציונלי בשלב זה) ---
# https://resend.com/api-keys
AUTH_RESEND_KEY=""
# כתובת "מאת" מאומתת ב-Resend
EMAIL_FROM="onboarding@resend.dev"

# --- Payload CMS ---
# openssl rand -base64 33
PAYLOAD_SECRET=""

# --- "תשלום פר רכישה" — מנוע המעקב (WP-2) ---
# הצפנת מפתחות ה-API של תוסף ה-WooCommerce (AES-256-GCM). 32 בייטים ב-base64:
# openssl rand -base64 32
# אופציונלי בפיתוח — בלעדיו צימוד אתר יחזיר שגיאה ברורה.
TRACK_KEY_SECRET=""
# סוד ל-endpoints של ה-cron (Authorization: Bearer <CRON_SECRET>).
# openssl rand -base64 33 — אופציונלי בפיתוח (ראה src/app/api/cron/*).
CRON_SECRET=""

# --- חיבור OAuth לפלטפורמות יוצרים (יוטיוב וכו') — WP-5 ---
# הצפנת טוקני refresh (AES-256-GCM). 32 בייטים ב-base64:
# openssl rand -base64 32
# אופציונלי בפיתוח — בלעדיו הצפנה/פענוח של טוקני OAuth יחזירו שגיאה ברורה.
OAUTH_TOKEN_SECRET=""
# YouTube (Google Cloud Console → OAuth 2.0 Client). redirect: <AUTH_URL>/api/connect/youtube/callback
YOUTUBE_OAUTH_CLIENT_ID=""
YOUTUBE_OAUTH_CLIENT_SECRET=""
# Facebook/Instagram (Meta for Developers → App). redirect: <AUTH_URL>/api/connect/facebook/callback
# דורש Enforce HTTPS — בפיתוח הרץ `npm run dev` (next dev --experimental-https).
FACEBOOK_OAUTH_CLIENT_ID=""
FACEBOOK_OAUTH_CLIENT_SECRET=""
# "Facebook Login for Business" מתעלם מ-scope — צריך Configuration ID:
# Meta dashboard → Facebook Login for Business → Configurations → Create → login variation "Business",
# הרשאות: pages_show_list, pages_read_engagement, instagram_basic; asset types: Pages + Instagram.
FACEBOOK_LOGIN_CONFIG_ID=""
