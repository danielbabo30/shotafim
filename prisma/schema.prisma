// Prisma schema — שותפים / BridgeAd
// מסמכי Prisma: https://pris.ly/d/prisma-schema
// שינוי סכמה: ערוך כאן ואז `npm run db:migrate`. ה-CLI של Payload לא מעורב (schema נפרד: payload).
//
// כללי אצבע:
//  • מזהים: cuid() בכל הטבלאות.
//  • כסף: Decimal @db.Decimal(12,2), שדות בסיומת ...ILS. אף פעם לא Float לכסף.
//  • enums משותפים (VerificationStatus / ProfileStatus / LegalEntityType) — לא לשכפל.
//  • מחיקה רכה (deletedAt) לפרופילים ולנכסים; לוגים פיננסיים/משפטיים לא נמחקים (onDelete: Restrict).
//  • חשבוניות: שכבה פיקטיבית — pdfUrl מקומי, externalProvider=LOCAL_MOCK עד חיבור API אמיתי.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooler — לזמן ריצה
  directUrl = env("DIRECT_URL") // חיבור ישיר — למיגרציות בלבד
}

// ═══════════════════════════════════════════════════════════════
//  Enums
// ═══════════════════════════════════════════════════════════════

/// כובעים שמשתמש יכול ללבוש. משתמש יכול להחזיק כמה במקביל (roles[]).
enum UserRole {
  BRAND
  CREATOR
  AD_SPACE_OWNER
  ADMIN
}

enum UserStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
  BANNED
}

/// סטטוס פרופיל/נכס — משותף לכל סוגי הפרופילים.
enum ProfileStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// אימות ידני ע"י צוות המערכת — משותף.
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// סוג התאגדות לצורכי מס — משותף לעסק ולספק מדיה.
