enum CreatorTaxStatus {
  EXEMPT_DEALER
  LICENSED_DEALER
  COMPANY
  INDIVIDUAL_WITHHOLDING
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  LINKEDIN
}

enum DeliverableType {
  IG_REEL
  IG_STORY
  TIKTOK_VIDEO
  YOUTUBE_INTEGRATION
  EVENT_ATTENDANCE
}

enum AdSpaceType {
  DIGITAL_BILLBOARD
  STATIC_BILLBOARD
  TRANSIT
  NEWSLETTER
  PODCAST_SPONSORSHIP
}

enum AdPricingModel {
  DAILY
  WEEKLY
  MONTHLY
  PER_CPM
  PER_BROADCAST
}

/// סוג ההוכחה הנדרש לשחרור ה-Escrow עבור שטח פרסום.
enum ProofRequirement {
  PHOTO_CONFIRMATION
  ANALYTICS_REPORT
  SYSTEM_LOG
}

enum CampaignTargetType {
  CREATOR
  AD_SPACE
  BOTH
}

enum CampaignStatus {
  DRAFT
  OPEN_FOR_PITCHES
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  INVITED // המפרסם הזמין את הספק לבריף — טרם הוגשה הצעה
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  AWAITING_ESCROW
  ACTIVE
  SUBMITTED_FOR_REVIEW
  APPROVED
  DISPUTED
  REFUNDED
}

enum BookingStatus {
  RESERVED
  CONFIRMED
  BROADCASTING
  COMPLETED
  CANCELLED
}

enum EscrowStatus {
  HELD
  RELEASED_TO_PROVIDER
  REFUNDED_TO_BRAND
  SPLIT_DISPUTE
}

enum TransactionType {
  ESCROW_DEPOSIT
  ESCROW_RELEASE
  WITHDRAWAL
  PLATFORM_FEE
  REFUND
  // תשלום פר רכישה (revenue-share)
  PARTNERSHIP_DEPOSIT // הפקדת המפרסם לפיקדון השותפות
  COMMISSION_ACCRUAL // עמלה נצברה מרכישה משויכת
  COMMISSION_PAYOUT // תשלום בתחנת תשלום לארנק היוצר
  COMMISSION_REVERSAL // ביטול עמלה בעקבות החזרה
  DEPOSIT_REFUND // יתרת פיקדון שלא נוצלה חזרה למפרסם
  PLATFORM_ABSORPTION // הפלטפורמה סופגת זנב לא-גבה (§6) — עד תקרה
