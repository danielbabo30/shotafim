enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum InvoiceDocumentType {
  TAX_INVOICE
  RECEIPT
  CREDIT_INVOICE
}

/// ספק החשבוניות. LOCAL_MOCK = מסמך דמה מקומי עד חיבור API אמיתי.
enum InvoiceProvider {
  LOCAL_MOCK
  GREEN_INVOICE
  MORNING
}

enum SubmissionStatus {
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
}

enum ProofType {
  PHOTO_PROOF
  SYSTEM_LOG
  ANALYTICS_EXPORT
}

enum NotificationType {
  ESCROW_LOCKED
  SUBMISSION_RECEIVED
  REVISION_NEEDED
  PAYMENT_RELEASED
  // תשלום פר רכישה
  TRACKING_OFFLINE // תוסף המעקב אינו מדווח
  DEPOSIT_LOW // פיקדון השותפות חצה את שער ה-80%
  PARTNERSHIP_PAUSED // הלינק/קופון הושהו
  COMMISSION_ACCRUED // עמלה חדשה נצברה
}

enum DisputeReason {
  MISSED_DEADLINE
  LOW_QUALITY
  BRIEF_DEVIATION
  NON_RESPONSIVE
  // תשלום פר רכישה
  UNDERREPORTED_SALES // חשד לדיווח חסר של מכירות
  FRAUDULENT_ORDERS // חשד להזמנות מזויפות
  ATTRIBUTION_DISPUTE // חילוקי דעות על שיוך מכירה
  PLUGIN_NOT_REPORTING // התוסף אינו מדווח כנדרש
}

enum DisputeStatus {
  OPEN
  UNDER_ARBITRATION
  RESOLVED_REFUND
  RESOLVED_PAYOUT
  SPLIT
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ConsentDocumentType {
  TERMS_OF_SERVICE
  ESCROW_AGREEMENT
  PRIVACY_POLICY
  PARTNERSHIP_AGREEMENT // הסכם שותפות מבוססת-ביצועים (תשלום פר רכישה)
}

enum MediaFileType {
  VIDEO_DRAFT
  IMAGE_ASSET
  INVOICE_PDF
  PROOF_OF_PLAY
}

enum BlockReportReason {
  OFF_PLATFORM_PAYMENT_ATTEMPT
  HARASSMENT
  SPAM
  COPYRIGHT_INFRINGEMENT
}

enum BlockReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum IsraelDistrict {
  TEL_AVIV
  CENTRAL
  NORTH
  SOUTH
  JERUSALEM
  HAIFA
  JUDEA_SAMARIA
}

// ═══════════════════════════════════════════════════════════════
//  תשלום פר רכישה (revenue-share) — enums
//  אפיון מלא: Artifact "תשלום פר רכישה". WP-1 = סכמה + הקמת שותפות בלבד.
// ═══════════════════════════════════════════════════════════════

/// מודל התגמול — מימד נפרד מסוג היעד (יוצר / שטח פרסום).
enum CompensationModel {
  FIXED_FEE // קיים — סכום קבוע, Escrow, אבני דרך
  REVENUE_SHARE // תשלום פר רכישה — עמלה על מכירות
  HYBRID // v2 — דמי בסיס + עמלה
}

enum CommissionType {
  PERCENT
  FIXED
}

/// האם העמלה מחושבת לפני או אחרי הנחת הקופון.
enum CommissionBasis {
  PRE_DISCOUNT
  POST_DISCOUNT
}

/// האם העמלה על מחיר המוצר המופנה בלבד או על כל הסל.
enum CommissionScope {
  PRODUCT_ONLY
  WHOLE_CART
}

enum AttributionMode {
  LINK
  COUPON
  LINK_AND_COUPON
}

enum AttributionMethod {
  COUPON
  COOKIE
  MANUAL
}

enum TopUpMode {
  MANUAL
  AUTO
}

enum ProgramStatus {
  PENDING_DEPOSIT // הוקם, ממתין להפקדת הפיקדון — הלינק/קופון לא "עולה"
  ACTIVE
  GATE_80 // חצה 80% ניצול פיקדון — ממתין להחלטה משותפת
  PAUSED
  CLOSED
}

enum SitePlatform {
  WOOCOMMERCE
}

enum SiteStatus {
  ACTIVE
  STALE // אין heartbeat > 12 שעות
  OFFLINE // התראה נורתה
  DEACTIVATED
}

enum OrderCommissionStatus {
  PENDING
  ON_HOLD // המפרסם עצר עמלה בודדת לבירור — לא מתנקזת עד הכרעה
  APPROVED
  REVERSED
  PAID
}

enum CheckpointStatus {
  SCHEDULED
  PAID
  SHORTFALL
}

enum PluginAlertType {
  DEACTIVATED
  HEARTBEAT_ABSENT
  WEBHOOK_MISMATCH
}

enum EnforcementType {
  WARNING
  FINE
  SUSPENSION
  BAN
}

/// בחירת צד בשער ה-80% (§6).
enum GateChoice {
  CONTINUE
  STOP
}

/// דגלי אנומליה אוטומטיים (§7) — נכתבים ב-monitor cron, נקראים ע"י האדמין.
enum AnomalyType {
  CLICK_ORDER_RATIO_DROP // יחס קליקים→הזמנות שצנח פתאום
  RETURN_RATE_SPIKE // שיעור החזרות חריג
  VELOCITY_SPIKE // קפיצת קצב הזמנות
  VELOCITY_DROP // צניחת קצב הזמנות
  SELF_PURCHASE // customerHash == היוצר
  POST_CHECKPOINT_RETURN // הזמנה→החזרה אחרי תחנת תשלום
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

// ═══════════════════════════════════════════════════════════════
//  משתמשים ואימות (Auth.js / NextAuth — PrismaAdapter)
// ═══════════════════════════════════════════════════════════════

model User {
  id               String     @id @default(cuid())
  name             String? // שדה של האדפטר — שם תצוגה קנוני
  email            String?    @unique
  emailVerified    DateTime?
  image            String? // שדה של האדפטר — אווטאר כללי
  phone            String?    @unique
  phoneVerified    DateTime?
  passwordHash     String? // שמור ל-passwordless עכשיו; nullable לעתיד
  roles            UserRole[] @default([])
  activeRole       UserRole? // איזה כובע ה-UI מציג כרגע
  status           UserStatus @default(PENDING_ONBOARDING)
  twoFactorEnabled Boolean    @default(false)
  lastLoginAt      DateTime?
  termsAcceptedAt  DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  accounts Account[]
  sessions Session[]

  businessProfile     BusinessProfile?
  creatorProfile      CreatorProfile?
  adSpaceOwnerProfile AdSpaceOwnerProfile?

  campaignApplications CampaignApplication[]     @relation("ApplicationApplicant")
  sentCampaignInvites  CampaignApplication[]     @relation("ApplicationInviter")
  providerContracts    Contract[]                @relation("ContractProvider")
  transactions         Transaction[]
  invoices             Invoice[]
  sentMessages         Message[]
  conversations        ConversationParticipant[]
  notifications        Notification[]
  deliverableFeedback  ContentFeedback[]
  authoredReviews      Review[]                  @relation("ReviewAuthor")
  receivedReviews      Review[]                  @relation("ReviewTarget")
  reviewPrompts        ReviewPrompt[]
  auditLogs            AuditLog[]
  legalConsents        LegalConsent[]
  uploadedMedia        MediaAttachment[]
  openedDisputes       Dispute[]                 @relation("DisputeInitiator")
  arbitratedDisputes   Dispute[]                 @relation("DisputeArbitrator")
  disputeMessages      DisputeMessage[]
  reportsMade          UserBlockReport[]         @relation("BlockReporter")
  reportsReceived      UserBlockReport[]         @relation("BlockReported")

  enforcementActionsReceived EnforcementAction[] @relation("EnforcementTarget")
  enforcementActionsIssued   EnforcementAction[] @relation("EnforcementIssuer")
  declaredMaintenanceWindows MaintenanceWindow[]

  @@index([status])
  @@index([deletedAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ═══════════════════════════════════════════════════════════════
//  פרופיל עסק (BRAND)
// ═══════════════════════════════════════════════════════════════

model BusinessProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  name               String
  legalName          String?
  companyId          String             @unique // ח.פ / עוסק מורשה
  entityType         LegalEntityType
  description        String
  businessModel      BusinessModel
  status             ProfileStatus      @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  logoUrl            String?
  websiteUrl         String?
  socialLinks        Json? // { instagram, tiktok, facebook }
  contactName        String
  contactPhone       String
  billingEmail       String
  billingAddress     String
  billingCustomerId  String? // מזהה לקוח בספק הסליקה
  partnershipDebtILS Decimal            @default(0) @db.Decimal(12, 2) // חוב חריגת פיקדון פתוח (§6) — > 0 חוסם פתיחת קמפיינים חדשים
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations    BusinessLocation[]
  categories   BusinessCategory[]
  campaigns    Campaign[]
  contracts    Contract[]
  trackedSites TrackedSite[]

  @@index([verificationStatus])
  @@index([status])
}

/// סניפי העסק — רק לעסקים פיזיים או היברידיים.
model BusinessLocation {
  id         String   @id @default(cuid())
  businessId String
  name       String? // כינוי הסניף
  cityId     String
  address    String
  isPrimary  Boolean  @default(false)
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  city      City            @relation(fields: [cityId], references: [id])
  campaigns Campaign[]

  @@index([businessId])
  @@index([cityId])
}

// ═══════════════════════════════════════════════════════════════
//  פרופיל יוצר (CREATOR)
// ═══════════════════════════════════════════════════════════════

model CreatorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  legalFullName      String // שם מלא לפי ת.ז — למשיכות ודיווח מס
  idNumber           String             @unique // ת.ז / ח.פ / עוסק
  taxStatus          CreatorTaxStatus
  bio                String
  primaryCityId      String?
  avatarUrl          String?
  coverImageUrl      String?
  status             ProfileStatus      @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  reliabilityScore   Float              @default(0) // 0-100, מבוסס עמידה בזמנים וסיום קמפיינים
  payoutBankDetails  Json? // { bank, branch, account, accountHolder }
  billingAddress     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryCity     City?                   @relation(fields: [primaryCityId], references: [id])
  channels        CreatorChannel[]
  pricingPackages CreatorPricingPackage[]
  categories      CreatorCategory[]

  @@index([verificationStatus])
  @@index([status])
  @@index([primaryCityId])
}

/// ערוצי הסושיאל של היוצר (יחס 1:N).
model CreatorChannel {
  id                String         @id @default(cuid())
  creatorId         String
  platform          SocialPlatform
  handle            String
  channelUrl        String
  followersCount    Int            @default(0)
  avgViews          Int?
  engagementRate    Float?
  isChannelVerified Boolean        @default(false) // חובר דרך OAuth / API
  lastSyncedAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
  @@index([creatorId])
}

/// מחירון ושירותים של היוצר (יחס 1:N).
model CreatorPricingPackage {
  id                String          @id @default(cuid())
  creatorId         String
  deliverableType   DeliverableType
  title             String
  priceILS          Decimal         @db.Decimal(12, 2) // לפני מע"מ / עמלת מערכת
  turnaroundDays    Int
  revisionsIncluded Int             @default(1)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  creator      CreatorProfile        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  applications CampaignApplication[]
  contracts    Contract[]

  @@index([creatorId])
}

// ═══════════════════════════════════════════════════════════════
//  פרופיל ספק מדיה (AD_SPACE_OWNER)
// ═══════════════════════════════════════════════════════════════

model AdSpaceOwnerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyName        String
  legalName          String
  companyId          String             @unique
  entityType         LegalEntityType
  contactName        String
  contactPhone       String
  billingEmail       String
  billingAddress     String
  payoutBankDetails  Json? // פרטי חשבון בנק לקבלת כספי Escrow
  verificationStatus VerificationStatus @default(PENDING)
  status             ProfileStatus      @default(ACTIVE)
  reliabilityScore   Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets AdSpaceAsset[]

  @@index([verificationStatus])
  @@index([status])
}

/// נכסי המדיה ושטחי הפרסום (יחס 1:N).
model AdSpaceAsset {
  id               String           @id @default(cuid())
  ownerId          String
  title            String
  type             AdSpaceType
  description      String
  cityId           String? // חובה לשטחים פיזיים, ריק לדיגיטליים
  address          String?
  dimensions       String? // "12x4 מטר"
  technicalSpecs   Json? // רזולוציה, יחס מסך, פורמטים, משקל, אורך ספוט
  estimatedReach   Int? // חשיפות משוערות לתקופה
  pricingModel     AdPricingModel
  basePriceILS     Decimal          @db.Decimal(12, 2)
  images           String[]
  proofRequirement ProofRequirement
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  owner        AdSpaceOwnerProfile    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  city         City?                  @relation(fields: [cityId], references: [id])
  categories   AdSpaceAssetCategory[]
  applications CampaignApplication[]
  contracts    Contract[]
  bookings     AdSpaceBooking[]

  @@index([ownerId])
  @@index([cityId])
  @@index([type, isActive])
}

// ═══════════════════════════════════════════════════════════════
//  נתוני עזר: ערים וקטגוריות
// ═══════════════════════════════════════════════════════════════

model City {
  id        String         @id @default(cuid())
  nameHe    String         @unique
  nameEn    String?
  district  IsraelDistrict
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)

  businessLocations BusinessLocation[]
  creators          CreatorProfile[]
  adSpaceAssets     AdSpaceAsset[]
  contractShippings ContractShipping[]

  @@index([district])
}

// הקטגוריות עצמן מנוהלות ב-Payload (collection `categories`, schema payload) —
// עריכה דרך /admin. כאן שומרים רק את ה-slug כהפניה רופפת (בלי FK חוצה-schema).
// מחיקת קטגוריה ב-Payload: להשתמש ב-isActive=false, לא במחיקה קשה.

model CreatorCategory {
  creatorId    String
  categorySlug String

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([creatorId, categorySlug])
  @@index([categorySlug])
}

model BusinessCategory {
  businessId   String
  categorySlug String

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, categorySlug])
  @@index([categorySlug])
}

model CampaignCategory {
  campaignId   String
  categorySlug String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, categorySlug])
  @@index([categorySlug])
}

model AdSpaceAssetCategory {
  adSpaceAssetId String
  categorySlug   String

  adSpaceAsset AdSpaceAsset @relation(fields: [adSpaceAssetId], references: [id], onDelete: Cascade)

  @@id([adSpaceAssetId, categorySlug])
  @@index([categorySlug])
}

// ═══════════════════════════════════════════════════════════════
//  קמפיינים, הצעות וחוזים
// ═══════════════════════════════════════════════════════════════

/// בריף / קמפיין ראשי שמפרסם עסק.
model Campaign {
  id                 String             @id @default(cuid())
  businessId         String
  locationId         String? // סניף ספציפי (אופציונלי)
  title              String
  description        String
  targetType         CampaignTargetType
  targetPlatforms    String[]
  deliverables       DeliverableType[] // תוצרים מבוקשים מהבריף
  briefAssetsUrl     String? // קישור לחומרי גלם / מיתוג
  hasPhysicalProduct Boolean            @default(false) // מוצר פיזי שנשלח ליוצר → הוא יתבקש כתובת משלוח
  compensationModel  CompensationModel  @default(FIXED_FEE) // FIXED_FEE / REVENUE_SHARE — נקבע בבריף
  totalBudgetILS     Decimal            @db.Decimal(12, 2)
  startDate          DateTime?
  endDate            DateTime?
  status             CampaignStatus     @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business      BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location      BusinessLocation?     @relation(fields: [locationId], references: [id])
  applications  CampaignApplication[]
  contracts     Contract[]
  categories    CampaignCategory[]
  conversations Conversation[]
  partnerTerms  CampaignPartnerTerms?

  @@index([businessId])
  @@index([status])
}

/// הצעת מחיר / פנייה של יוצר או בעל שטח לבריף.
model CampaignApplication {
  id                    String            @id @default(cuid())
  campaignId            String
  applicantId           String // User.id של המגיש
  pricingPackageId      String? // אם הצעה מבוססת חבילת יוצר
  adSpaceAssetId        String? // אם הצעה מבוססת שטח פרסום
  proposedPriceILS      Decimal           @db.Decimal(12, 2)
  coverLetter           String?
  estimatedDeliveryDays Int
  status                ApplicationStatus @default(SUBMITTED)
  invitedByUserId       String? // מפרסם שיזם הזמנה (status=INVITED); null אם הספק יזם
  requestedStartDate    DateTime? // חלון מבוקש — לשריון שטח פרסום
  requestedEndDate      DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  campaign       Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  applicant      User                   @relation("ApplicationApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  invitedBy      User?                  @relation("ApplicationInviter", fields: [invitedByUserId], references: [id])
  pricingPackage CreatorPricingPackage? @relation(fields: [pricingPackageId], references: [id])
  adSpaceAsset   AdSpaceAsset?          @relation(fields: [adSpaceAssetId], references: [id])
  contract       Contract?

  @@unique([campaignId, applicantId])
  @@index([applicantId])
  @@index([status])
}

/// הסכם עבודה מחייב לקמפיין.
model Contract {
  id                 String            @id @default(cuid())
  campaignId         String
  applicationId      String?           @unique
  businessId         String
  providerId         String // User.id של היוצר / בעל השטח שנבחר
  pricingPackageId   String?
  adSpaceAssetId     String?
  agreedPriceILS     Decimal           @db.Decimal(12, 2)
  platformFeeILS     Decimal           @db.Decimal(12, 2)
  compensationModel  CompensationModel @default(FIXED_FEE) // מועתק מהקמפיין בעת האישור
  deadline           DateTime
  status             ContractStatus    @default(AWAITING_ESCROW)
  revisionRoundsMax  Int               @default(2) // מכסת סבבי תיקונים בהסכם
  revisionRoundsUsed Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  completedAt        DateTime?

  campaign       Campaign               @relation(fields: [campaignId], references: [id])
  application    CampaignApplication?   @relation(fields: [applicationId], references: [id])
  business       BusinessProfile        @relation(fields: [businessId], references: [id])
  provider       User                   @relation("ContractProvider", fields: [providerId], references: [id])
  pricingPackage CreatorPricingPackage? @relation(fields: [pricingPackageId], references: [id])
  adSpaceAsset   AdSpaceAsset?          @relation(fields: [adSpaceAssetId], references: [id])

  escrowHold     EscrowHold?
  shipping       ContractShipping?
  bookings       AdSpaceBooking[]
  submissions    DeliverableSubmission[]
  proofs         ProofOfPlay[]
  transactions   Transaction[]
  dispute        Dispute?
  reviews        Review[]
  reviewPrompts  ReviewPrompt[]
  conversations  Conversation[]
  partnerProgram PartnerProgram?

  @@index([campaignId])
  @@index([businessId])
  @@index([providerId])
  @@index([status])
}

/// כתובת משלוח שהיוצר מעדכן לחוזה עם מוצר פיזי (Campaign.hasPhysicalProduct).
model ContractShipping {
  id            String   @id @default(cuid())
  contractId    String   @unique
  recipientName String
  phone         String
  address       String
  cityId        String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  city     City?    @relation(fields: [cityId], references: [id])

  @@index([cityId])
}

/// מעקב "נדנוד" לבקשת ביקורת — פר (חוזה, משתמש). המודאל חוזר 3 ימים אחרי dismiss,
/// ומפסיק אחרי dismissCount>=3 (עדיין אפשר להשאיר ביקורת מחדר העבודה).
model ReviewPrompt {
  contractId   String
  userId       String
  dismissedAt  DateTime
  dismissCount Int      @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contractId, userId])
  @@index([userId])
}

/// יומן שיבוצים לשטחי פרסום.
model AdSpaceBooking {
  id             String        @id @default(cuid())
  adSpaceAssetId String
  contractId     String
  startDate      DateTime
  endDate        DateTime
  status         BookingStatus @default(RESERVED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  adSpaceAsset AdSpaceAsset @relation(fields: [adSpaceAssetId], references: [id])
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([adSpaceAssetId, startDate, endDate])
  @@index([contractId])
}

// ═══════════════════════════════════════════════════════════════
//  כספים — Escrow, תנועות, חשבוניות (שכבה פיקטיבית בשלב זה)
// ═══════════════════════════════════════════════════════════════

/// נעילת כספים בנאמנות לחוזה. מעברי סטטוס ידניים/אדמין עד חיבור PSP.
model EscrowHold {
  id         String       @id @default(cuid())
  contractId String       @unique
  amountILS  Decimal      @db.Decimal(12, 2)
  status     EscrowStatus @default(HELD)
  fundedAt   DateTime? // מועד הפקדת הכסף ע"י העסק
  releasedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([status])
}

/// יומן תנועות כספיות בארנק המערכת.
model Transaction {
  id           String            @id @default(cuid())
  userId       String
  contractId   String?
  type         TransactionType
  amountILS    Decimal           @db.Decimal(12, 2)
  feeAmountILS Decimal           @default(0) @db.Decimal(12, 2)
  status       TransactionStatus @default(PENDING)
  referenceId  String? // אסמכתא מספק הסליקה / העברה בנקאית
  createdAt    DateTime          @default(now())

  user     User      @relation(fields: [userId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])
  invoices Invoice[]

  @@index([userId])
  @@index([contractId])
  @@index([type])
}

/// מסמכי חיוב, קבלות וחשבוניות מס. פיקטיבי: pdfUrl מקומי, provider=LOCAL_MOCK.
model Invoice {
  id                 String              @id @default(cuid())
  transactionId      String?
  recipientUserId    String
  documentType       InvoiceDocumentType
  amountBeforeTax    Decimal             @db.Decimal(12, 2)
  taxAmount          Decimal             @db.Decimal(12, 2)
  totalAmount        Decimal             @db.Decimal(12, 2)
  customerName       String
  customerTaxId      String
  pdfUrl             String?
  externalProvider   InvoiceProvider     @default(LOCAL_MOCK)
  externalDocumentId String? // מזהה מסמך מהספק החיצוני
  issuedAt           DateTime            @default(now())

  transaction Transaction? @relation(fields: [transactionId], references: [id])
  recipient   User         @relation(fields: [recipientUserId], references: [id])

  @@index([transactionId])
  @@index([recipientUserId])
}

// ═══════════════════════════════════════════════════════════════
//  תוצרים, הגשות והוכחות שידור
// ═══════════════════════════════════════════════════════════════

/// הגשות תוכן וסקיצות לבדיקה (עבור יוצרים).
model DeliverableSubmission {
  id                String           @id @default(cuid())
  contractId        String
  version           Int
  fileUrl           String // URL מוגש: /api/contract-files/<id> לקובץ שהועלה, או קישור חיצוני
  mediaAttachmentId String?          @unique // קובץ שהועלה (null = קישור חיצוני)
  notes             String?
  status            SubmissionStatus @default(PENDING_REVIEW)
  submittedAt       DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  contract        Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  mediaAttachment MediaAttachment?  @relation(fields: [mediaAttachmentId], references: [id])
  feedback        ContentFeedback[]

  @@unique([contractId, version])
  @@index([contractId])
}

/// הערות ותיקונים על גבי תוצר, כולל חותמת זמן בוידאו.
model ContentFeedback {
  id               String   @id @default(cuid())
  submissionId     String
  authorId         String // User.id של העסק
  timestampSeconds Int? // Timecode בוידאו
  feedbackText     String
  isResolved       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  submission DeliverableSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User                  @relation(fields: [authorId], references: [id])

  @@index([submissionId])
}

/// אימות שידור לשטחי פרסום (עבור בעלי שטחים).
model ProofOfPlay {
  id              String    @id @default(cuid())
  contractId      String
  proofType       ProofType
  fileUrl         String
  notes           String?
  verifiedByBrand Boolean   @default(false)
  uploadedAt      DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

// ═══════════════════════════════════════════════════════════════
//  תקשורת והתראות
// ═══════════════════════════════════════════════════════════════

/// שיחה מבוססת הקשר (בריף / חוזה) או ישירה.
model Conversation {
  id         String   @id @default(cuid())
  campaignId String?
  contractId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign     Campaign?                 @relation(fields: [campaignId], references: [id])
  contract     Contract?                 @relation(fields: [contractId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([campaignId])
  @@index([contractId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  actionUrl String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ═══════════════════════════════════════════════════════════════
//  מחלוקות ובוררות
// ═══════════════════════════════════════════════════════════════

model Dispute {
  id              String        @id @default(cuid())
  contractId      String        @unique
  initiatorId     String
  reason          DisputeReason
  description     String
  status          DisputeStatus @default(OPEN)
  arbitratorId    String? // מנהל מערכת שמטפל בתיק
  resolutionNotes String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  resolvedAt      DateTime?

  contract           Contract            @relation(fields: [contractId], references: [id])
  initiator          User                @relation("DisputeInitiator", fields: [initiatorId], references: [id])
  arbitrator         User?               @relation("DisputeArbitrator", fields: [arbitratorId], references: [id])
  messages           DisputeMessage[]
  enforcementActions EnforcementAction[]

  @@index([status])
}

/// פרוטוקול וראיות במחלוקת.
model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  senderId    String // צד או בורר
  message     String
  evidenceUrl String?
  createdAt   DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id])

  @@index([disputeId])
}

// ═══════════════════════════════════════════════════════════════
//  דירוגים, ביקורת ותיעוד משפטי
// ═══════════════════════════════════════════════════════════════

/// דירוג והמלצות דו-צדדיות לאחר חוזה.
model Review {
  id                  String          @id @default(cuid())
  contractId          String
  authorId            String
  targetId            String
  sentiment           ReviewSentiment
  rating              Int // 1-5
  feedbackText        String
  punctualityRating   Int?
  communicationRating Int?
  paymentRating       Int?
  isPublic            Boolean         @default(true)
  createdAt           DateTime        @default(now())

  contract Contract @relation(fields: [contractId], references: [id])
  author   User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  target   User     @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([contractId, authorId])
  @@index([targetId])
}

/// יומן ביקורת. append-only — אין updatedAt, אין מחיקה.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  ipAddress  String?
  userAgent  String?
  metadata   Json? // { before, after }
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
}

/// תיעוד הסכמות חוזיות (append-only).
model LegalConsent {
  id           String              @id @default(cuid())
  userId       String
  documentType ConsentDocumentType
  version      String // "v1.2"
  ipAddress    String?
  acceptedAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// ניהול קבצים מאובטח במערכת.
model MediaAttachment {
  id               String        @id @default(cuid())
  uploaderId       String
  fileUrl          String // URL מוגש: /api/contract-files/<id>
  originalFilename String?
  fileType         MediaFileType
  mimeType         String
  fileSizeBytes    BigInt
  checksum         String? // SHA-256
  createdAt        DateTime      @default(now())

  uploader              User                   @relation(fields: [uploaderId], references: [id])
  deliverableSubmission DeliverableSubmission?

  @@index([uploaderId])
}

/// דיווחים וחסימות משתמשים.
model UserBlockReport {
  id             String            @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         BlockReportReason
  description    String
  evidenceUrl    String?
  status         BlockReportStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  reporter     User @relation("BlockReporter", fields: [reporterId], references: [id])
  reportedUser User @relation("BlockReported", fields: [reportedUserId], references: [id])

  @@index([reportedUserId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
//  תשלום פר רכישה (revenue-share) — מודלים
//  WP-1: הסכמה מלאה + הקמת שותפות. מנוע השיוך/הכסף, ה-endpoints,
//  הדשבורדים והתוסף — WP-2+. מודלים ריקים בשלב זה זה בסדר.
// ═══════════════════════════════════════════════════════════════

/// תנאי שותפות מבוססת-ביצועים שהמפרסם מצהיר בבריף (הצעה; בלי נגד-הצעה ב-WP-1).
/// מועתקים ל-PartnerProgram ונעולים בעת acceptApplication.
model CampaignPartnerTerms {
  id                 String          @id @default(cuid())
  campaignId         String          @unique
  commissionType     CommissionType
  commissionValue    Decimal         @db.Decimal(12, 2) // אחוז (0-100) אם PERCENT, ש"ח אם FIXED
  commissionBasis    CommissionBasis @default(PRE_DISCOUNT)
  commissionScope    CommissionScope @default(PRODUCT_ONLY)
  estimatedPurchases Int // תחזית רכישות לתקופה — מוסכמת, עוגן לפיקדון
  assumedAovILS      Decimal         @db.Decimal(12, 2) // ערך הזמנה ממוצע — עוגן תחזית + בסיס לחישוב פיקדון בעמלת אחוז
  attributionMode    AttributionMode @default(LINK_AND_COUPON)
  destinationUrl     String // עמוד היעד באתר המפרסם
  couponDiscountPct  Decimal?        @db.Decimal(5, 2) // הנחת הקופון לקונה — המפרסם קובע
  payoutCheckpoints  DateTime[] // תאריכי תחנות תשלום; האחרונה נאכפת ל-endDate+14
  startDate          DateTime
  endDate            DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

/// תוכנית שותפות פעילה — פר חוזה. נוצרת ב-acceptApplication (PENDING_DEPOSIT),
/// עולה ל-ACTIVE אחרי fundPartnerDeposit. הלינק/קופון לא "עולה" עד ACTIVE.
model PartnerProgram {
  id                 String          @id @default(cuid())
  contractId         String          @unique
  commissionType     CommissionType
  commissionValue    Decimal         @db.Decimal(12, 2)
  commissionBasis    CommissionBasis
  commissionScope    CommissionScope
  estimatedPurchases Int
  assumedAovILS      Decimal         @db.Decimal(12, 2) // מועתק מהתנאים — עוגן תחזית + חישוב פיקדון
  requiredDepositILS Decimal         @db.Decimal(12, 2)
  drainedILS         Decimal         @default(0) @db.Decimal(12, 2) // סכום שנוקז מהפיקדון (commission+fee) על עמלות APPROVED; שערי 80/100 מודדים מולו
  depositHoldId      String? // EscrowHold.id של הפיקדון (reuse התשתית הקיימת)
  attributionMode    AttributionMode
  refCode            String          @unique // קוד שיוך קצר וקריא (לינק + זיהוי)
  couponCode         String?         @unique // קוד קופון ייחודי ליוצר (אם attributionMode כולל COUPON)
  couponDiscountPct  Decimal?        @db.Decimal(5, 2)
  destinationUrl     String
  platformFeePct     Decimal         @db.Decimal(5, 2) // PARTNERSHIP_PLATFORM_FEE_PCT בעת ההקמה
  startDate          DateTime
  endDate            DateTime
  payoutCheckpoints  DateTime[]
  topUpMode          TopUpMode       @default(MANUAL)
  status             ProgramStatus   @default(PENDING_DEPOSIT)
  pausedAt           DateTime?
  pauseReason        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  contract     Contract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clicks       AffiliateClick[]
  orders       AttributedOrder[]
  checkpoints  PayoutCheckpoint[]
  alerts       PluginAlert[]
  gateEvents   PartnerGateEvent[]
  anomalyFlags AnomalyFlag[]

  @@index([status])
}

/// אתר WooCommerce מצומד לתוסף המעקב.
model TrackedSite {
  id              String       @id @default(cuid())
  businessId      String
  siteUrl         String
  platform        SitePlatform @default(WOOCOMMERCE)
  apiKeyHash      String // sha256(apiKey) — לחיפוש ולדחייה מוקדמת
  apiKeyEnc       String // apiKey מוצפן (AES-256-GCM, env TRACK_KEY_SECRET) — לאימות HMAC
  status          SiteStatus   @default(ACTIVE)
  lastHeartbeatAt DateTime?
  staleAt         DateTime? // מתי סומן STALE
  offlineAt       DateTime? // מתי סומן OFFLINE (התראה נורתה)
  pluginVersion   String?
  wooVersion      String?
  wpVersion       String?
  phpVersion      String?
  pairedAt        DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business           BusinessProfile     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  attributedOrders   AttributedOrder[]
  maintenanceWindows MaintenanceWindow[]
  pluginAlerts       PluginAlert[]

  @@unique([businessId, siteUrl])
  @@index([status])
}

/// קליק על לינק שיוך — נדגם server-side ע"י התוסף.
model AffiliateClick {
  id           String   @id @default(cuid())
  programId    String
  occurredAt   DateTime
  landingUrl   String
  ipHash       String
  uaHash       String?
  country      String?
  unverifiable Boolean  @default(false) // קליק שנקלט בחלון תחזוקה מוצהר (§5)
  createdAt    DateTime @default(now())

  program PartnerProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, occurredAt])
}

/// הזמנה משויכת מדיווח התוסף. מקור האמת לחישוב עמלה (WP-2).
model AttributedOrder {
  id                   String                @id @default(cuid())
  programId            String
  siteId               String
  externalOrderId      String
  orderPlacedAt        DateTime
  currency             String                @default("ILS")
  grossAmount          Decimal               @db.Decimal(12, 2)
  commissionableAmount Decimal               @db.Decimal(12, 2) // לפי commissionBasis + commissionScope
  couponCodes          String[]
  attributionMethod    AttributionMethod
  customerHash         String
  isNewCustomer        Boolean               @default(true)
  status               OrderCommissionStatus @default(PENDING)
  orderStatusRaw       String? // סטטוס ההזמנה הגולמי מ-Woo — לבדיקת יציבות לפני APPROVED
  commissionAmount     Decimal               @db.Decimal(12, 2)
  platformFeeAmount    Decimal               @db.Decimal(12, 2)
  refundedAmountILS    Decimal?              @db.Decimal(12, 2) // החזר חלקי — העמלה מחושבת מחדש פרו-רטה
  lateFromDigest       Boolean               @default(false) // נקלט דרך ה-digest ולא webhook בזמן אמת
  approvedAt           DateTime?
  heldAt               DateTime?
  holdReason           String?
  paidAt               DateTime?
  payoutCheckpointId   String? // התחנה ששילמה את העמלה הזו
  reversedAt           DateTime?
  reversalReason       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  program          PartnerProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  site             TrackedSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  payoutCheckpoint PayoutCheckpoint? @relation(fields: [payoutCheckpointId], references: [id])

  @@unique([siteId, externalOrderId])
  @@index([programId, status])
  @@index([payoutCheckpointId])
}

/// תחנת תשלום — משחררת 100% מהעמלות המאושרות מאז התחנה הקודמת (בלי ריטנשן).
model PayoutCheckpoint {
  id                 String           @id @default(cuid())
  programId          String
  sequence           Int              @default(1) // סדר התחנה (1..N); התחנה האחרונה = endDate+14
  isFinal            Boolean          @default(false)
  scheduledFor       DateTime
  status             CheckpointStatus @default(SCHEDULED)
  grossCommissionILS Decimal          @default(0) @db.Decimal(12, 2) // עמלות APPROVED מאז התחנה הקודמת
  reversalsILS       Decimal          @default(0) @db.Decimal(12, 2) // ביטולים שקוזזו בתחנה זו
  carryInILS         Decimal          @default(0) @db.Decimal(12, 2) // חוב ביטולים שנגרר מהתחנה הקודמת
  paidILS            Decimal          @default(0) @db.Decimal(12, 2) // ששולם בפועל ליוצר
  processedAt        DateTime?
  paidAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  program PartnerProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  orders  AttributedOrder[]

  @@index([programId])
  @@index([status, scheduledFor])
}

/// חלון תחזוקה מוצהר מראש — היעדרות heartbeat בתוכו לא מפעילה התראה.
model MaintenanceWindow {
  id               String   @id @default(cuid())
  siteId           String
  startsAt         DateTime
  endsAt           DateTime
  note             String?
  declaredByUserId String
  createdAt        DateTime @default(now())

  site           TrackedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  declaredByUser User        @relation(fields: [declaredByUserId], references: [id])

  @@index([siteId, startsAt])
}

/// התראת ניטור תוסף.
model PluginAlert {
  id           String          @id @default(cuid())
  siteId       String
  programId    String?
  type         PluginAlertType
  detail       String?
  detectedAt   DateTime        @default(now())
  notifiedAt   DateTime? // מתי נשלחו התראה + מייל
  graceEndsAt  DateTime? // סוף חלון החסד לפני auto-pause (§5)
  resolvedAt   DateTime?
  autoPausedAt DateTime?

  site    TrackedSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  program PartnerProgram? @relation(fields: [programId], references: [id])

  @@index([siteId])
  @@index([type])
  @@index([resolvedAt])
}

/// אירוע שער 80% (§6) — נפתח כשהניצול חוצה 80%, נסגר ב-top-up / עצירה / auto-pause ב-100%.
/// היסטוריה — השער יכול להיפתח שוב אחרי top-up.
model PartnerGateEvent {
  id               String      @id @default(cuid())
  programId        String
  openedAt         DateTime    @default(now())
  thresholdPct     Int         @default(80)
  drainedAtOpenILS Decimal     @db.Decimal(12, 2)
  depositAtOpenILS Decimal     @db.Decimal(12, 2)
  brandChoice      GateChoice?
  providerChoice   GateChoice?
  resolvedAt       DateTime?
  resolution       String? // TOPPED_UP | STOPPED | AUTO_PAUSED_100

  program PartnerProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([resolvedAt])
}

/// דגל אנומליה אוטומטי (§7) — נכתב ב-monitor cron, נקרא ע"י האדמין (WP-3b) ומצורף לתיקי מחלוקת.
model AnomalyFlag {
  id          String          @id @default(cuid())
  programId   String
  type        AnomalyType
  severity    AnomalySeverity
  detail      String
  metricValue Decimal?        @db.Decimal(14, 4)
  detectedAt  DateTime        @default(now())
  resolvedAt  DateTime?

  program PartnerProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, type, detectedAt])
  @@index([programId])
  @@index([resolvedAt])
}

/// פעולת אכיפה מנהלתית — מתחברת ל-User.status ומורידה reliabilityScore.
model EnforcementAction {
  id              String          @id @default(cuid())
  targetUserId    String
  type            EnforcementType
  reason          String
  disputeId       String?
  amountILS       Decimal?        @db.Decimal(12, 2) // לקנס
  issuedByAdminId String
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())

  target        User     @relation("EnforcementTarget", fields: [targetUserId], references: [id])
  issuedByAdmin User     @relation("EnforcementIssuer", fields: [issuedByAdminId], references: [id])
  dispute       Dispute? @relation(fields: [disputeId], references: [id])

  @@index([targetUserId])
  @@index([type])
}
